# Host port used by Caddy. 3001 avoids a common existing service on port 3000.
ICONNEST_BIND=127.0.0.1
ICONNEST_PORT=3001

# Conservative defaults for a small VPS. Raise these for heavy public traffic.
ICONNEST_NODE_MEMORY_MB=256
ICONNEST_MEMORY_LIMIT=384m
ICONNEST_CPU_LIMIT=1.0
ICONNEST_LOG_SIZE=10m

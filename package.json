{
  "name": "iconnest",
  "version": "0.1.0",
  "private": true,
  "description": "A beautiful, local-first icon library and management workspace.",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "fflate": "^0.8.3",
    "geist": "1.7.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "typescript": "7.0.2"
  },
  "type": "module",
  "license": "MIT",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
